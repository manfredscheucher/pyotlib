FROM python:3.12-slim

WORKDIR /app

# install build deps
RUN pip install --upgrade pip

# copy only what's needed for install
COPY pyproject.toml .
COPY pyotlib2/ pyotlib2/
COPY tests/ tests/

RUN pip install -e ".[dev,sat,scipy]"

CMD ["python", "-m", "pytest", "tests/", "-q", "--tb=short", \
     "--ignore=tests/otdb", "-k", "not slow", "--timeout=120"]
