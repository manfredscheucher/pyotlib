FROM python:3.12-slim

WORKDIR /app

# install dependencies first (cached unless pyproject.toml changes)
COPY pyproject.toml .
RUN mkdir -p pyotlib2 && touch pyotlib2/__init__.py \
    && pip install --upgrade pip \
    && pip install -e ".[dev,sat,scipy]"

# copy source and tests (changes often, but deps layer is cached)
COPY pyotlib2/ pyotlib2/
COPY tests/ tests/

CMD ["python", "-m", "pytest", "tests/", "-q", "--tb=short", \
     "--ignore=tests/otdb", "-k", "not slow", "--timeout=120"]
